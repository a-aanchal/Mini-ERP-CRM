generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  role           String          @default("SALES")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  challans       Challan[]
  followUps      FollowUp[]

  @@index([email])
}

model Customer {
  id           Int        @id @default(autoincrement())
  customerName String
  mobileNumber String
  email        String
  businessName String
  gstNumber    String?
  customerType String     @default("RETAIL")
  address      String
  status       String     @default("LEAD")
  followUpDate DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  followUps    FollowUp[]
  challans     Challan[]

  @@index([customerName])
  @@index([email])
  @@index([mobileNumber])
  @@index([status])
}

model FollowUp {
  id           Int       @id @default(autoincrement())
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  notes        String
  followUpDate DateTime?
  createdById  Int
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id                Int             @id @default(autoincrement())
  productName       String
  sku               String          @unique
  category          String
  unitPrice         Float
  currentStock      Int             @default(0)
  minimumStock      Int             @default(5)
  warehouseLocation String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  stockMovements    StockMovement[]
  challanItems      ChallanItem[]

  @@index([sku])
  @@index([category])
}

model StockMovement {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int
  movementType String
  reason       String
  createdById  Int
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Challan {
  id            Int           @id @default(autoincrement())
  challanNumber String        @unique
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id])
  totalQuantity Int           @default(0)
  status        String        @default("DRAFT")
  createdById   Int
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         ChallanItem[]

  @@index([challanNumber])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model ChallanItem {
  id                  Int     @id @default(autoincrement())
  challanId           Int
  challan             Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           Int
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Float
  quantity            Int
}
